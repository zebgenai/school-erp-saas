# Clever Campus ERP frontend
# Copy to .env for local overrides. On Render, set these in the dashboard.

# Local Docker / nginx same-origin:
# VITE_API_URL=/api

# Local Vite (proxies /api to Nest):
# VITE_API_URL=http://localhost:3000/api

# Render split services (must include /api):
VITE_API_URL=https://api.yourdomain.com/api
