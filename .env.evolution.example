# Must match backend EVOLUTION_API_KEY
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY

EVOLUTION_SERVER_URL=http://127.0.0.1:8080

# Confirm this tag exists on Docker Hub before use.
# Verified source contract: EvolutionAPI/evolution-api @ 2.3.7
EVOLUTION_DOCKER_IMAGE=evoapicloud/evolution-api:v2.3.7
