# Placeholders only — copy for local Evolution stack.
#   docker compose -f docker-compose.evolution.yml --env-file .env.evolution.example up -d
# Never commit real secrets.

EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME_EVOLUTION_POSTGRES_PASSWORD
