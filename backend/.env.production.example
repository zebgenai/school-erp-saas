# ── Database (Render Postgres Internal URL) ─────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=5&sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS="7"
# Access and refresh tokens both use JWT_SECRET. OTP hashes use OTP_PEPPER or JWT_SECRET.
OTP_PEPPER=""

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Public HTTPS origin of the frontend (password-reset links). Never a From domain.
FRONTEND_URL="https://clever-campus-frontend.onrender.com"

# Comma-separated allowed browser origins. Must match the frontend HTTPS URL.
CORS_ORIGINS="https://clever-campus-frontend.onrender.com"

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Not used by application code today. Leave empty on Render unless you add a Redis instance.
REDIS_URL=""

# ── Uploads (ephemeral on Render free/starter disks) ─────────────────────────
UPLOAD_DIR="uploads"

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Clever Campus <noreply@YOUR_VERIFIED_DOMAIN>"
EMAIL_FROM_NAME="Clever Campus"
EMAIL_FROM_LOCAL=
EMAIL_FROM_DOMAIN=
RESEND_API_KEY=
RESEND_FROM="Clever Campus <noreply@YOUR_VERIFIED_DOMAIN>"
# SMTP fallback (Gmail app password) if Resend test domain cannot mail other users
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Clever Campus"

# ── Optional monitoring ────────────────────────────────────────────────────────
# LOG_LEVEL=info
# SENTRY_DSN=
