DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp_saas"
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS="7"
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"
# Frontend origin (reset-password links). Not an email sending domain.
FRONTEND_URL="http://localhost:8080"

# ── Email (development) ───────────────────────────────────────────────────────
# FRONTEND_URL is only used for password-reset *links*. It is never a From domain.
# Resend test sender (no production domain required).
# Use EMAIL_FROM with @resend.dev, or compose it from:
#   EMAIL_FROM_LOCAL="onboarding"
#   EMAIL_FROM_DOMAIN="resend.dev"
# Do not use @example.com or localhost as EMAIL_FROM.
# FRONTEND_URL is never used as a From address.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="Clever Campus <beth.t@example.com>"
EMAIL_FROM_NAME="Clever Campus"
EMAIL_FROM_LOCAL="onboarding"
EMAIL_FROM_DOMAIN="resend.dev"
RESEND_API_KEY=""
RESEND_FROM="Clever Campus <beth.t@example.com>"

# SMTP — required to send OTP to every user (not only the Resend account email).
# Resend's @resend.dev test sender can only deliver to the email on your Resend account.
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_PASS=""
# Must be the same Gmail as SMTP_USER (not example.com, not FRONTEND_URL).
SMTP_FROM=""
SMTP_FROM_NAME="Clever Campus"
# Optional dedicated HMAC pepper for OTP hashes (falls back to JWT_SECRET)
OTP_PEPPER=""

