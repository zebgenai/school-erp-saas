# Clever Campus ERP — Docker Compose production environment
# Copy to .env on the VPS and replace placeholders. Never commit .env.
#
#   cp .env.example .env
#
# POSTGRES_PASSWORD is interpolated into DATABASE_URL. Use hex or alphanumeric
# only (no @ : / # ? %). Example: openssl rand -hex 24
# JWT_SECRET must be at least 32 characters. Example: openssl rand -hex 32

# ── Public URLs (CORS, password-reset emails, browser origin) ───────────────
FRONTEND_URL=https://YOUR_DOMAIN
BACKEND_URL=https://YOUR_DOMAIN/api
CORS_ORIGINS=https://YOUR_DOMAIN

# Frontend build-time API base (same-origin via nginx reverse proxy)
VITE_API_URL=/api

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=clevercampus
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=school_erp_saas

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# Optional dedicated HMAC pepper for OTP hashes (falls back to JWT_SECRET)
# OTP_PEPPER=

# ── Redis (internal Docker network; not published to the host) ───────────────
REDIS_URL=redis://redis:6379

# ── Uploads (container path; persisted on the uploads_data volume) ───────────
# UPLOAD_DIR=/app/uploads

# ── Email (optional — required for OTP / password-reset mail in production) ─
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Clever Campus <noreply@YOUR_DOMAIN>
# EMAIL_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM=Clever Campus <noreply@YOUR_DOMAIN>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@YOUR_DOMAIN
# SMTP_FROM_NAME=Clever Campus

# ── Host ports ───────────────────────────────────────────────────────────────
HTTP_PORT=80
# HTTPS_PORT=443
