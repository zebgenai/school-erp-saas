# Clever Campus ERP — Docker Compose environment
# Copy to .env and fill in secrets before running: cp .env.example .env

# ── Public URLs (used by CORS, password-reset emails, etc.) ─────────────────
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost/api
CORS_ORIGINS=http://localhost

# Frontend build-time API base (same-origin via nginx reverse proxy)
VITE_API_URL=/api

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=clevercampus
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=school_erp_saas

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ── Redis (prepared for future caching / sessions) ───────────────────────────
REDIS_URL=redis://redis:6379

# ── SMTP (optional — required for email notifications in production) ─────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# ── Host ports ───────────────────────────────────────────────────────────────
HTTP_PORT=80
# HTTPS_PORT=443
